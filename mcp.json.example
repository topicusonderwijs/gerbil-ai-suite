{
  "servers": {
    "grafana": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GRAFANA_URL=https://your-grafana-instance.com/",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN=your-service-account-token-here",
        "mcp/grafana",
        "-t",
        "stdio"
      ]
    },
    "smartbear": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@smartbear/mcp@latest"
      ],
      "env": {
        "BUGSNAG_AUTH_TOKEN": "your-bugsnag-auth-token-here",
        "BUGSNAG_PROJECT_API_KEY": "your-bugsnag-project-api-key-here-or-leave-empty"
      }
    }
  }
}
