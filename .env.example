# Grafana Configuration
GRAFANA_URL=https://your-grafana-instance.com
GRAFANA_SERVICE_ACCOUNT_TOKEN=your-service-account-token-here

# Bugsnag Configuration (SmartBear MCP)
BUGSNAG_AUTH_TOKEN=your-bugsnag-auth-token-here
BUGSNAG_PROJECT_API_KEY=your-bugsnag-project-api-key-here-optional

# Note: Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed
